{
  "system": "claude-exa",
  "agent": "claude",
  "search": "exa",
  "model": "claude-sonnet-5",
  "timeout_seconds": 1800,
  "answer_extract": "claude_json",
  "setup_files": {
    "mcp.json": {
      "mcpServers": {
        "exa": {
          "type": "http",
          "url": "https://mcp.exa.ai/mcp?exaApiKey={EXA_API_KEY}&tools=web_search_exa,web_fetch_exa"
        }
      }
    }
  },
  "cmd": [
    "claude",
    "-p",
    "{PROMPT}",
    "--output-format",
    "json",
    "--model",
    "claude-sonnet-5",
    "--setting-sources",
    "project",
    "--strict-mcp-config",
    "--mcp-config",
    "{WORKDIR}/mcp.json",
    "--allowed-tools",
    "mcp__exa",
    "--disallowed-tools",
    "WebSearch,WebFetch,Bash,Edit,Write,NotebookEdit,Task,TodoWrite"
  ]
}
