{
  "system": "claude-exa-or",
  "agent": "claude",
  "search": "exa",
  "model": "anthropic/claude-sonnet-5",
  "transport": "openrouter",
  "timeout_seconds": 1800,
  "answer_extract": "claude_json",
  "require_env": [
    "OPENROUTER_API_KEY",
    "EXA_API_KEY"
  ],
  "extra_env": {
    "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
    "ANTHROPIC_AUTH_TOKEN": "{OPENROUTER_API_KEY}",
    "ANTHROPIC_MODEL": "anthropic/claude-sonnet-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "anthropic/claude-sonnet-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "anthropic/claude-haiku-4.5",
    "ANTHROPIC_SMALL_FAST_MODEL": "anthropic/claude-haiku-4.5"
  },
  "unset_env": [
    "ANTHROPIC_API_KEY"
  ],
  "note": "Held-out control (Amendment L): identical to claude_exa.json except model calls routed via OpenRouter.",
  "setup_files": {
    "mcp.json": {
      "mcpServers": {
        "exa": {
          "type": "http",
          "url": "https://mcp.exa.ai/mcp?exaApiKey={EXA_API_KEY}&tools=web_search_exa,web_fetch_exa"
        }
      }
    }
  },
  "cmd": [
    "claude",
    "-p",
    "{PROMPT}",
    "--output-format",
    "json",
    "--model",
    "anthropic/claude-sonnet-5",
    "--setting-sources",
    "project",
    "--strict-mcp-config",
    "--mcp-config",
    "{WORKDIR}/mcp.json",
    "--allowed-tools",
    "mcp__exa",
    "--disallowed-tools",
    "WebSearch,WebFetch,Bash,Edit,Write,NotebookEdit,Task,TodoWrite"
  ]
}
